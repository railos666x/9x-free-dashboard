# Python
.venv/
__pycache__/
*.pyc

# Data + local files (DB, logs, optimizer cache, exchange keys)
data/
*.db
*.db-wal
*.db-shm
.env

# Runtime logs (server-run.log / server.err.log and one-off test logs) —
# redirect targets of a locally started server, never source. .gitignore
# rather than "just don't add them": they reappear on every restart.
*.log

# Local editor config (never commit)
.vscode/

# Database snapshots (scripts/backup_db.py)
backups/

# Streamlit
.streamlit/

# OS
Thumbs.db
.DS_Store
