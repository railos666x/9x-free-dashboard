# Copy this file to `.env` and fill in your key.
# Get a free key at https://cryptopanic.com/  (free account → API)
CRYPTOPANIC_API_KEY=your_key_here

# --- AI News Reviewer (free-tool chain; the reviewer works without these) ---
# The reviewer is a failover chain: primary (LLM_* below) first, then each
# entry in LLM_FALLBACKS, then the built-in rule-based scorer if all fail.
# All providers are FREE tiers and OpenAI-compatible (verified Aug 2026):
#
#   Gemini Flash — free key from Google AI Studio (ai.google.dev, no card),
#       ~tens of requests/day on the free tier. OpenAI-compatible endpoint.
#   OpenRouter   — one free key (openrouter.ai/keys), 28+ free $0 models
#       (DeepSeek R1, Llama 3.3 70B, Qwen3), ~50-1000 req/day.
#   Groq         — free key (console.groq.com), llama-3.3-70b-versatile,
#       very fast, ~1000 req/day free.
#
# Recommended setup: Gemini as primary, OpenRouter + Groq as fallbacks.
LLM_ENABLED=true
# --- Primary: Gemini Flash (free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.1-flash-lite   # current free-tier Flash (2.5-flash is deprecated for new users)
# LLM_API_KEY=AIza...
# (Or any other OpenAI-compatible primary, e.g. OpenAI:)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
#
# --- Free fallbacks (tried in order after the primary) ---
# Format: `;`-separated entries of `base_url|model[|api_key]`.
# Cloud providers REQUIRE a key (keyless entries are skipped automatically);
# local endpoints like llama.cpp (localhost) work keyless.
# LLM_FALLBACKS="https://openrouter.ai/api/v1|deepseek/deepseek-r1:free|sk-or-...;https://api.groq.com/openai/v1|llama-3.3-70b-versatile|gsk_..."
#
# How often the LLM overlay may re-ask a provider (seconds). The last
# successful verdict is served from cache inside this window so free tiers
# aren't burned by the 20s signals refresh. Default 600 (10 min).
# LLM_MIN_INTERVAL_SECONDS=600

# --- Alpha Vantage News & Sentiment (backend/news.py) ---
# Free key at alphavantage.co/support/#api-key (ak_live_...). One
# NEWS_SENTIMENT call returns the top crypto stories with real per-ticker
# sentiment scores + relevance (not keyword guesses). Free tier = 25
# requests/day, so fetching is throttled to ALPHA_NEWS_FETCH_HOURS (6h
# default = max 4 calls/day). Note: the free crypto feed can lag by months;
# the reviewer's 12h decay zeroes stale scores, so old items never move the
# gate. Optional — no key = RSS + Groq still work.
# ALPHA_VANTAGE_API_KEY=ak_live_...
# ALPHA_NEWS_ENABLED=true
# ALPHA_NEWS_FETCH_HOURS=6
# ALPHA_NEWS_LIMIT=50

# --- Tavily — real-time news + article extraction (backend/news.py, web_scraper.py) ---
# Free key at tavily.com (tvly-...). Two jobs:
#   1. news.py — one `topic=news` search per TAVILY_NEWS_FETCH_HOURS (6h
#      default = ≤4 calls/day, free tier ~1000 credits/month) returns FRESH
#      stories with real published dates (Alpha Vantage's free feed lags by
#      months). TAVILY_NEWS_QUERY is the search term (broad crypto default).
#   2. web_scraper.py — Tavily's `extract` endpoint is the automatic
#      fallback when Firecrawl is off / unkeyed / out of credits.
# TAVILY_API_KEY=tvly-...
# TAVILY_NEWS_ENABLED=true
# TAVILY_NEWS_FETCH_HOURS=6
# TAVILY_NEWS_LIMIT=20
# TAVILY_NEWS_DAYS=1          # look back this many days for fresh stories
# TAVILY_NEWS_QUERY=cryptocurrency market news

# --- Firecrawl web scraping (backend/web_scraper.py) ---
# Free key at firecrawl.dev (fc-...). Turns a news URL into clean markdown
# so the AI agents reason over the FULL article, not the bare headline:
#   /api/news/analyze?url=<article>&headline=<title>
# Content is cached in the `article_content` table for
# FIRECRAWL_CACHE_TTL_HOURS (24h) so credits aren't re-burned. Also:
#   python backend/web_scraper.py enrich [limit]   # pre-warm the cache
# When Firecrawl is off/unkeyed/fails, Tavily's extract endpoint (key above)
# is used automatically.
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_ENABLED=true
# FIRECRAWL_CACHE_TTL_HOURS=24
# FIRECRAWL_TIMEOUT=60

# --- Finnhub — real-time market data + news (finnhub.io) ---
# Real-time quotes, company news, market sentiment. Free tier: 60 req/min.
# Covers forex, stocks, and crypto. Get free key at: finnhub.io/register
# FINNHUB_API_KEY=your_finnhub_key

# --- FRED (Federal Reserve Economic Data) — macro indicators ---
# 816K+ economic time series: GDP, CPI, unemployment, interest rates.
# Free, no API key required for basic access (120 req/min).
# Optional key increases to unlimited. Get at: fred.stlouisfed.org/docs/api/api_key.html
# FRED_ENABLED=true
# FRED_API_KEY=your_fred_key   # optional, for higher rate limits

# --- CoinGecko — crypto market data (NO API KEY REQUIRED) ---
# Comprehensive crypto data: prices, volume, market cap, social metrics.
# Free tier is rate-limited (10-30 req/min) but unlimited in total calls.
# Documentation: docs.coingecko.com. Works out of the box!
# COINGECKO_ENABLED=true
# COINGECKO_API_KEY=   # optional Pro key for higher rate limits

# --- NewsAPI.org — 80K+ news sources worldwide ---
# Real-time news from 80,000+ sources. Free tier: 100 requests/day.
# Broader coverage than Tavily for global news. Get key at: newsapi.org/register
# NEWSAPI_ORG_KEY=your_newsapi_key

# --- ExchangeRate-API — forex rate backup ---
# 165+ currency rates. Free tier: 1,500 req/month. Useful backup when MT5
# forex data lags. Get key at: exchangerate-api.com/pricing
# EXCHANGERATE_API_KEY=your_exchangerate_key

# --- Groq News Analyst (backend/news_analyst.py) ---
# The MAIN news sentiment & analytics engine when a key is set: structured
# per-asset analytics (sentiment -1..1, confidence, impact horizon, asset
# mentions). Free key at console.groq.com/keys. Cached 10 min; falls back
# to the Gemini chain + rule-based scorer when unset or rate-limited.
# GROQ_API_KEY=gsk_...
# Primary + fallback, verified against this account's /models on
# 2026-08-17 (qwen/qwen3.6-27b was 429 quota-exhausted and
# llama-3.3-70b-versatile is NOT a real model on Groq — the failover never
# failed over and the chain stalled ~2.5 min of backoff per analysis).
# GROQ_MODEL=openai/gpt-oss-120b       # answers the batched analysis in ~2s
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# NEWS_ANALYST_ENABLED=true
# NEWS_ANALYST_CACHE_TTL=600           # seconds between Groq analyses
#
# News-driven trade thresholds (sentiment -1..+1, confidence 0..1):
# NEWS_SIGNAL_LONG=0.35                # score >= this → LONG candidate
# NEWS_SIGNAL_SHORT=-0.35              # score <= this → SHORT candidate
# NEWS_SIGNAL_MIN_CONFIDENCE=0.6       # floor for a news trade to fire

# --- AI Agents (backend/ai_agents.py) ---
# Three production agent prompts run on the same LLM transport:
#   1. News catalyst sentiment (headline → sentiment/impact/black-swan)
#   2. HODL / portfolio research (catalyst → hold recommendation)
#   3. Chart confluence (price vs support/resistance → verify news trades)
# AI_AGENTS_ENABLED=true
# AI_AGENT_MODEL=              # defaults to GROQ_MODEL
# AI_CONFLUENCE_GATE=false     # verify news source-B signals against the
#                              # chart before they become proposals (OFF
#                              # by default — it changes trade behavior)

# --- OmniRoute — local AI gateway (news_analyst / ai_agents / reviewer) ---
# Free, MIT, LOCAL-FIRST OpenAI-compatible gateway (github.com/diegosouzapw/OmniRoute):
# one endpoint in front of 300+ providers / 1200+ models with quota-aware
# auto-fallback. Runs on your machine (default localhost:20128) and is
# keyless — the `auto` combo picks the best free backend live. The news
# analyst + AI agents try Groq first (when GROQ_API_KEY is set), then
# OmniRoute; the reviewer chain gains it as a keyless local provider.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_ENABLED=true
# OMNIROUTE_MODEL=auto         # or a named combo: auto/coding, auto/fast, ...
# OMNIROUTE_API_KEY=           # optional — local gateway is keyless

# --- Execution (single order path; see backend/execution.py) ---
# Broker: paper (default, offline fills from our candles), alpaca (free
# paper trading via REST, no SDK), or binance (signed spot orders).
# EXECUTION_BROKER=paper
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true          # false = LIVE orders — be careful
# BINANCE_EXEC_API_KEY=
# BINANCE_EXEC_API_SECRET=

# --- Signal source (backend/bot.py) ---
# ai_news (default since 2026-08-17) = the ONLY trade source: the Groq news
# analyst (news_analyst.signal_for) scores the Tavily / Alpha Vantage / RSS
# headlines per asset and fires LONG/SHORT above the NEWS_SIGNAL_* thresholds.
# The bot trades ONLY config.TRADING_UNIVERSE (Exness forex/metals/indices on
# MT5) — crypto pairs and the Bitcoin ETFs were retired from trading.
#
# The old candle-factor engines (math_engine / strategy / hybrid) and the
# proprietary RSI(2) source are RETIRED from the trade path. They still power
# /api/signals (dashboard display) and the backtester, and can be re-enabled
# here for dry-testing — but LIVE runs with a legacy engine require the
# two-source gate (ARBITRATION_MIN_SOURCES=2).
# SIGNAL_SOURCE_A=ai_news
#
# --- AI verification layers ---
# AI_CONFLUENCE_GATE=false   # true = agent 3 verifies each news signal
#                            #   against the live chart (support/resistance)
#                            #   before it becomes a proposal; false = news
#                            #   signals trade directly (still data-gated)
# NEWS_VERIFY_ENABLED=false  # the old reviewer.verify_trade news gate is
#                            #   redundant on the AI path (the signal IS news);
#                            #   re-enable for a hard opposing-headline veto
#
# --- Proprietary signal source #2 (RETIRED — see proprietary_signals.py) ---
# Formerly the second half of the two-source gate; the bot no longer calls it.
# Kept in the repo for tests and reference.
# PROPRIETARY_SIGNALS_ENABLED=false
# PROPRIETARY_MODE=rsi2
# PROPRIETARY_RSI_LOW=25     # LONG when RSI(2) below this
# PROPRIETARY_RSI_HIGH=75    # SHORT when RSI(2) above this
#
# --- Bot loop ---
# BOT_LOOP_SECONDS=300       # cadence of `python bot.py loop`
# BOT_AUTO_LOOP=false        # true = server.py starts the bot loop as a
#                            #   background thread (no manual `python bot.py loop`)
# BOT_AUTO_LOOP_LIVE=false   # true = the auto-loop places orders. Safety rail:
#                            #   real-money brokers (live Alpaca/Binance) are
#                            #   refused and fall back to dry-run automatically.
#
# --- Agreement gate (backend/arbitrator.py — legacy engines only) ---
# 2 = BOTH sources must agree (required for LIVE runs on a legacy engine).
# 1 = single-source test mode (dry-run only unless ALLOW_LIVE_SINGLE_SOURCE
# is set). The ai_news path is single-source BY DESIGN and exempt.
# ARBITRATION_MIN_SOURCES=2
# ARBITRATION_MIN_CONFIDENCE=45   # floor for a lone legacy source
#
# --- Live safety (legacy engines only) ---
# Kill-switch: LIVE runs with a legacy engine are blocked while
# ARBITRATION_MIN_SOURCES=1 unless this is explicitly enabled.
# ALLOW_LIVE_SINGLE_SOURCE=false
#
# --- Alpaca fees ---
# Alpaca crypto orders carry no fee info, so the journal estimates from this
# rate (bps). Default 25 = their 0.25% taker tier-1 fee. Raise to 30 if you
# are on a higher-volume tier that still pays more, or set 0 to disable.
# ALPACA_FEE_BPS=25
#
# --- Position sizing ---
# One position may never exceed this fraction of account equity (notional
# cap). Prevents a burst of simultaneous signals from spending the book.
# MAX_POSITION_PCT=0.15
# Max concurrently open positions (new entries held back beyond this).
# MAX_OPEN_POSITIONS=5
#
# --- Loss guard (circuit breaker, backend/execution.loss_guard_status) ---
# Checked at the top of every bot cycle BEFORE new entries: realized PnL
# today may not exceed MAX_DAILY_LOSS_PCT of start-of-day equity, and equity
# may never sit more than MAX_DRAWDOWN_PCT below its journal peak. When
# tripped, new entries are held (the SL/TP monitor still closes open
# positions). 0 disables that check. Defaults: 3% daily / 10% drawdown.
# MAX_DAILY_LOSS_PCT=3.0
# MAX_DRAWDOWN_PCT=10.0
#
# --- News verification gate (reviewer.verify_trade) ---
# After the signal sources agree on a trade, the news review acts as a
# CONFIRMATION layer: opposing headlines veto the trade, and an extreme
# score in either direction (|score| >= NEWS_BIG_MOVE_SCORE) means a big
# move is expected, so the bot stands aside ("confirmation AI says don't
# take"). Aligned headlines confirm; neutral/no news never blocks.
# NEWS_VERIFY_ENABLED=true
# NEWS_VETO_SCORE=30          # opposing |score| → veto the trade
# NEWS_CONFIRM_SCORE=20       # aligned |score| → confirm the trade
# NEWS_BIG_MOVE_SCORE=55      # |score| any direction → big move, stand aside
