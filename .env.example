# Copy this file to `.env` and fill in your key.
# Get a free key at https://cryptopanic.com/  (free account → API)
CRYPTOPANIC_API_KEY=your_key_here

# --- AI News Reviewer (optional; the reviewer works without these) ---
# To add an LLM overlay, set LLM_ENABLED=true plus your endpoint. Any
# OpenAI-compatible API works: OpenAI, DeepSeek, Qwen/DashScope, llama.cpp…
LLM_ENABLED=false
LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
